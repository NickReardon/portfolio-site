{
  "name": "personal-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @personal/web dev",
    "dev:host": "pnpm --filter @personal/web dev:host",
    "build": "pnpm --filter @personal/web build",
    "preview": "pnpm --filter @personal/web preview",
    "check": "pnpm --filter @personal/web check",
    "content:validate": "pnpm --filter @personal/web content:validate",
    "content:validate:release": "pnpm --filter @personal/web content:validate:release",
    "knowledge:preview": "op run --env-file ./.env.local -- pnpm --filter @personal/content-pipeline knowledge:preview",
    "knowledge:index": "pnpm --filter @personal/content-pipeline knowledge:index",
    "knowledge:search": "pnpm --filter @personal/content-pipeline knowledge:search",
    "resume:prepare": "pnpm --filter @personal/content-pipeline resume:prepare",
    "resume:validate": "pnpm --filter @personal/content-pipeline resume:validate",
    "resume:render": "pnpm --filter @personal/content-pipeline resume:render",
    "resume:publish": "pnpm --filter @personal/content-pipeline resume:publish",
    "resume:build": "pnpm --filter @personal/resume-generator build",
    "resume:validate:public": "pnpm --filter @personal/resume-generator validate",
    "social:build": "pnpm --filter @personal/web social:build",
    "privacy:check": "pnpm --filter @personal/content-pipeline privacy:check",
    "clean": "rimraf .local apps/web/.astro apps/web/dist apps/web/reports apps/web/.audit-tmp",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:cloudflare": "pnpm build && op run --env-file ./.env.1password -- pnpm exec wrangler pages deploy .local/build/web",
    "audit": "pnpm --filter @personal/web audit",
    "audit:staging": "pnpm --filter @personal/web audit:staging",
    "audit:scores": "pnpm --filter @personal/web audit:scores",
    "test": "pnpm --filter @personal/content-pipeline test"
  },
  "devDependencies": {
    "prettier": "^3.8.5",
    "prettier-plugin-astro": "^0.14.1",
    "rimraf": "^6.1.3",
    "wrangler": "^4.56.0"
  }
}
