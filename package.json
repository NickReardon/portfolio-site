{
  "name": "portfolio-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "prebuild": "npm run content:validate && astro check",
    "build": "astro build",
    "build:fixture": "npm run content:prepare -- --vault test/fixtures/vault && npm run resume:fixture && npm run social:build && npm run build",
    "preview": "astro preview",
    "check": "astro check",
    "check:first-flight": "node scripts/check-first-flight.mjs",
    "content:prepare": "node scripts/content-prepare.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "content:validate:release": "node scripts/validate-content.mjs --strict-media",
    "resume:preview": "node scripts/build-resume.mjs",
    "resume:build": "node scripts/build-all-resumes.mjs",
    "resume:fixture": "node scripts/build-fixture-resumes.mjs",
    "resume:validate": "node scripts/validate-resume.mjs",
    "social:build": "node scripts/build-social-card.mjs",
    "privacy:check": "node scripts/privacy-check.mjs",
    "package:release": "node scripts/package-release.mjs",
    "package:verify": "node scripts/verify-release-package.mjs",
    "test": "node --test test/*.test.mjs",
    "clean": "rimraf dist .astro reports .audit-tmp",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm run audit:lighthouse && npm run audit:pa11y",
    "audit:lighthouse": "node scripts/audit-pages.mjs lighthouse",
    "audit:pa11y": "node scripts/audit-pages.mjs pa11y",
    "audit:scores": "node scripts/print-scores.mjs",
    "audit:staging": "npm run audit:staging:lighthouse && npm run audit:staging:pa11y",
    "audit:staging:lighthouse": "node scripts/audit-pages.mjs lighthouse https://staging.nick-reardon.com",
    "audit:staging:pa11y": "node scripts/audit-pages.mjs pa11y https://staging.nick-reardon.com",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.21.0",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^6.4.7",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "lighthouse": "^13.4.0",
    "pa11y": "^9.1.1",
    "prettier": "^3.8.5",
    "prettier-plugin-astro": "^0.14.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "7.3.5",
    "wrangler": "^4.122.0",
    "yaml": "2.8.1"
  }
}
