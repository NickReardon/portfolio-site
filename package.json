{
  "name": "portfolio-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "prebuild": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "resume:validate": "node scripts/validate-resume.mjs",
    "elements:validate": "node scripts/validate-elements.mjs",
    "privacy:check": "python scripts/privacy-check.py",
    "social:build": "node scripts/build-social-card.mjs",
    "clean": "rimraf dist .astro reports .audit-tmp",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:cloudflare": "node scripts/deploy.mjs",
    "audit": "npm run audit:lighthouse && npm run audit:pa11y",
    "audit:lighthouse": "node scripts/audit-pages.mjs lighthouse",
    "audit:pa11y": "node scripts/audit-pages.mjs pa11y",
    "audit:scores": "node scripts/print-scores.mjs",
    "audit:staging": "npm run audit:staging:lighthouse && npm run audit:staging:pa11y",
    "audit:staging:lighthouse": "node scripts/audit-pages.mjs lighthouse https://staging.nick-reardon.com",
    "audit:staging:pa11y": "node scripts/audit-pages.mjs pa11y https://staging.nick-reardon.com",
    "astro": "astro",
    "discussions:sync": "node scripts/sync-discussions.mjs",
    "discussions:validate": "node scripts/sync-discussions.mjs --self-check && node scripts/validate-discussions.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.21.0",
    "astro": "^7.4.0",
    "remark-directive": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "lighthouse": "^13.4.0",
    "pa11y": "^9.1.1",
    "prettier": "^3.8.5",
    "prettier-plugin-astro": "^0.14.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
