---
import { Image } from "astro:assets";

type MediaKind = "image" | "video" | "youtube";

interface VideoSource {
  src: string;
  type: "video/mp4" | "video/webm";
}

interface Props {
  kind?: MediaKind;
  /** Pipeline-optimized when it comes from `image()`; a plain path otherwise. */
  src: ImageMetadata | string;
  alt?: string;
  title?: string;
  caption?: string;
  aspect?: `${number}/${number}`;
  poster?: string;
  sources?: VideoSource[];
  autoplay?: boolean;
  loop?: boolean;
  loading?: "eager" | "lazy";
  fetchPriority?: "high" | "low" | "auto";
}

const {
  kind = "image",
  src,
  alt = "",
  title = "Project video",
  caption,
  aspect = "16/9",
  poster,
  sources = [],
  autoplay = false,
  loop = false,
  loading = "lazy",
  fetchPriority,
} = Astro.props;
const [aspectWidth, aspectHeight] = aspect.split("/").map(Number);
const aspectStyle = `aspect-ratio: ${aspectWidth} / ${aspectHeight}`;

// Only pipeline-managed images (from `image()`) can be optimized; a plain path
// points at public/ and is served as authored.
const optimizedImage = typeof src === "string" ? undefined : src;
const rawSrc = typeof src === "string" ? src : src.src;

// Cap generated widths at the source's own width. The detail page lays out up to
// ~1100px, but several covers are only 508px, and asking for more just ships
// bigger blurry files. Vectors scale on their own, so widths would only emit
// identical copies.
const mediaWidths =
  optimizedImage && optimizedImage.format !== "svg"
    ? [508, 768, 1100].filter((width) => width <= optimizedImage.width)
    : undefined;
---

<figure class="project-media">
  {
    kind === "image" &&
      (optimizedImage ? (
        <Image
          src={optimizedImage}
          alt={alt}
          widths={mediaWidths}
          sizes="(min-width: 1200px) 1100px, 100vw"
          loading={loading}
          fetchpriority={fetchPriority}
          style={aspectStyle}
          class="project-media-frame object-cover"
        />
      ) : (
        <img
          src={rawSrc}
          alt={alt}
          loading={loading}
          fetchpriority={fetchPriority}
          style={aspectStyle}
          class="project-media-frame object-cover"
        />
      ))
  }

  {
    kind === "video" && (
      <video
        class="project-media-frame"
        style={aspectStyle}
        poster={poster}
        controls
        muted
        loop={loop}
        playsinline
        preload="metadata"
        data-project-autoplay={autoplay ? "true" : undefined}
        aria-label={title}
      >
        {sources.map((source) => (
          <source src={source.src} type={source.type} />
        ))}
        {sources.length === 0 && <source src={rawSrc} />}
        Your browser does not support embedded video.
      </video>
    )
  }

  {
    kind === "youtube" && (
      <iframe
        class="project-media-frame"
        style={aspectStyle}
        src={rawSrc}
        title={title}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      />
    )
  }

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!reducedMotion) {
    document
      .querySelectorAll<HTMLVideoElement>('video[data-project-autoplay="true"]')
      .forEach((video) => {
        void video.play().catch(() => undefined);
      });
  }
</script>
