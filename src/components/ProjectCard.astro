---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import {
  coverBox,
  entrySlug,
  formatDate,
  projectDescriptor,
} from "../utils/content";

interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: 2 | 3;
  imageLoading?: "eager" | "lazy";
  imageFetchPriority?: "high" | "low" | "auto";
}

const {
  project,
  headingLevel = 2,
  imageLoading = "lazy",
  imageFetchPriority,
} = Astro.props;
const { data } = project;
const slug = entrySlug(project.id);
const href = `/projects/${slug}/`;
const Heading = `h${headingLevel}` as "h2" | "h3";
const timeline = data.timeline ?? formatDate(data.date);
const cover = data.coverImage ? coverBox(data.coverImage) : null;
const descriptor = projectDescriptor(data);

/* Full-bleed while the card is vertical — half the page in the two-column
   band, the whole page below it — then a cover column of up to 324px once the
   card turns horizontal. */
const COVER_SIZES = "(min-width: 60rem) 324px, (min-width: 40rem) 46vw, 100vw";
---

<article class="card project-card">
  <a href={href} class="card-link">
    <div class="card-media">
      {
        data.coverImage ? (
          <Image
            class="cover-main"
            src={data.coverImage}
            alt=""
            width={cover!.width}
            height={cover!.height}
            widths={cover!.widths}
            sizes={COVER_SIZES}
            fit="cover"
            position="center"
            loading={imageLoading}
            fetchpriority={imageFetchPriority}
          />
        ) : (
          <div class="card-placeholder">
            <span>{data.title}</span>
          </div>
        )
      }
    </div>
    <div class="card-body">
      <div class="card-head">
        <div>
          <p class="card-date">{timeline}</p>
          <Heading class="card-title">{data.title}</Heading>
        </div>
        {data.featured && <span class="card-badge">Featured</span>}
      </div>

      {
        (data.role || descriptor) && (
          <div class="card-meta">
            {data.role && <span>{data.role}</span>}
            {descriptor && <span>{descriptor}</span>}
          </div>
        )
      }

      <p class="card-summary">{data.description}</p>
    </div>

    <div class="tag-row">
      {data.tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
  </a>
</article>

<style>
  .project-card {
    overflow: hidden;
  }

  /* Vertical by default: cover band, text, then the tag bar. The cover goes
     horizontal at 40rem, which is the width where a thumbnail column still
     leaves the text enough room to read. */
  .card-link {
    display: grid;
    /* The card stretches to the tallest in its row; without this the link
       stops at its own content and the tag bars sit at different heights.
       The text row takes the slack so the bar lands on the bottom edge. */
    grid-template-rows: auto 1fr auto;
    height: 100%;
  }

  .card-media {
    aspect-ratio: 16 / 10;
    background: var(--line-soft);
    overflow: hidden;
    position: relative;
  }

  /* The <Image> renders its own <img>, so this reaches past the scope on
     purpose; .card-media is scoped and keeps the match local to this card.
   *
   * contain, never cover: the cover was already cropped to 16/10 in the
   * frontmatter, so it is shown whole at that ratio everywhere. In the
   * vertical band it fills the slot exactly; in the thumbnail column the slot
   * is as tall as the text beside it, so the leftover shows as even bars of
   * --line-soft above and below. */
  .card-media :global(img) {
    height: 100%;
    inset: 0;
    object-fit: contain;
    position: absolute;
    transition: transform 300ms ease;
    width: 100%;
  }

  .card:hover .card-media :global(.cover-main) {
    transform: scale(1.03);
  }

  .card-placeholder {
    align-items: end;
    background:
      linear-gradient(135deg, var(--cover-accent), transparent 45%),
      linear-gradient(45deg, var(--cover-highlight), transparent 55%),
      var(--shade);
    display: flex;
    height: 100%;
    padding: 0.75rem;
    width: 100%;
  }

  .card-placeholder span {
    color: var(--ink-soft);
    font-size: 0.875rem;
    font-weight: 750;
  }

  .card-body {
    padding: 0.85rem 1rem;
  }

  .card-body > * + * {
    margin-top: 0.6rem;
  }

  .card-head {
    /* Without this the badge stretches to the height of the date-plus-title
       block beside it and renders as a tall blob rather than a pill. */
    align-items: flex-start;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: space-between;
  }

  .card-date {
    color: var(--accent-mid);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.125rem;
  }

  .card-title {
    color: var(--ink-strong);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.75rem;
    margin-top: 0.15rem;
  }

  .card-badge {
    background: var(--badge-bg);
    border-radius: 999px;
    color: var(--badge-ink);
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1rem;
    padding: 0.15rem 0.6rem;
  }

  .card-meta {
    color: var(--ink-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.875rem;
    font-weight: 650;
    gap: 0.3rem 0.5rem;
    line-height: 1.4;
  }

  .card-meta span {
    align-items: center;
    display: inline-flex;
  }

  .card-meta span + span::before {
    background: var(--line-strong);
    border-radius: 999px;
    content: "";
    display: inline-block;
    height: 0.3rem;
    margin-right: 0.5rem;
    width: 0.3rem;
  }

  /* Clamped so the text column stays a predictable height next to a fixed
     thumbnail; without it a long description decides the card's size. */
  .card-summary {
    color: var(--ink-muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    font-size: 0.95rem;
    line-height: 1.55;
    overflow: hidden;
  }

  /* Its own band across the full card, under both the text and the cover, so
     the tags stop competing with the description for the text column. */
  .tag-row {
    /* --shade rather than --page-subtle: the latter is within a hair of the
       page background, so the band read as though it sat outside the card. */
    background: var(--shade);
    border-top: 1px solid var(--line-soft);
    gap: 0.35rem;
    grid-column: 1 / -1;
    padding: 0.55rem 1rem;
  }

  /* The card only turns horizontal once it has the row to itself, which is the
     width where a cover column can be wide enough that its 16/10 height clears
     the text beside it. That ordering is the whole point: the leftover height
     then lands in the text column, where it is invisible, instead of under the
     cover where it reads as a gap. */
  @media (min-width: 60rem) {
    .card-link {
      /* Fixed, not a share: the cover's 16/10 height has to clear the text
         beside it at every width or the gap under it comes back, and the card
         is never narrower than about 920px here, so a share only ever shrank
         it below what the longest card needs. 20.25rem gives a 202px cover
         against a worst case of 186px of text.
       *
       * ponytail: that 186px is the longest role line in the collection today
       * (Stock Backtesting wraps to two). A card whose role runs to three
       * lines reopens the gap; widen this or clamp .card-meta if one lands. */
      grid-template-columns: minmax(0, 20.25rem) minmax(0, 1fr);
      /* The cover-and-text row takes the slack so the tag bar stays pinned to
         the bottom edge of the card. */
      grid-template-rows: 1fr auto;
    }

    /* The cover keeps its own 16/10 box rather than stretching to the row, so
       the art is never boxed in bars. */
    .card-media {
      align-self: start;
    }

    /* Centred against the taller cover, so the shorter text block sits level
       with it instead of hanging from the top edge. */
    .card-body {
      align-self: center;
    }

    /* The text column is most of the page by now, so the description needs a
       measure of its own or it runs well past a comfortable line length. */
    .card-summary {
      max-width: 68ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover .card-media :global(img) {
      transform: none;
    }
  }
</style>
