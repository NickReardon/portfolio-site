---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { entrySlug, formatDate } from "../utils/content";

interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: 2 | 3;
  imageLoading?: "eager" | "lazy";
  imageFetchPriority?: "high" | "low" | "auto";
}

const {
  project,
  headingLevel = 2,
  imageLoading = "lazy",
  imageFetchPriority,
} = Astro.props;
const { data } = project;
const slug = entrySlug(project.id);
const href = `/projects/${slug}/`;
const Heading = `h${headingLevel}` as "h2" | "h3";
const timeline = data.timeline ?? formatDate(data.date);
---

<article class="card project-card">
  <a href={href} class="card-link">
    <div class="card-media">
      {
        data.coverImage ? (
          <Image
            src={data.coverImage}
            alt=""
            width={640}
            height={400}
            loading={imageLoading}
            fetchpriority={imageFetchPriority}
          />
        ) : (
          <div class="card-placeholder">
            <span>{data.title}</span>
          </div>
        )
      }
    </div>
    <div class="card-body">
      <div class="card-head">
        <div>
          <p class="card-date">{timeline}</p>
          <Heading class="card-title">{data.title}</Heading>
        </div>
        {data.featured && <span class="card-badge">Featured</span>}
      </div>

      {
        (data.role || data.status || data.engine) && (
          <div class="card-meta">
            {data.role && <span>{data.role}</span>}
            {data.status && <span>{data.status}</span>}
            {data.engine && <span>{data.engine}</span>}
          </div>
        )
      }

      <p class="card-summary">{data.description}</p>

      <div class="tag-row">
        {data.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </div>
  </a>
</article>

<style>
  .project-card {
    overflow: hidden;
  }

  .card-media {
    aspect-ratio: 16 / 10;
    background: var(--line-soft);
    overflow: hidden;
  }

  /* The <Image> renders its own <img>, so this reaches past the scope on
     purpose; .card-media is scoped and keeps the match local to this card. */
  .card-media :global(img) {
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
    width: 100%;
  }

  .card:hover .card-media :global(img) {
    transform: scale(1.03);
  }

  .card-placeholder {
    align-items: end;
    background:
      linear-gradient(135deg, rgb(15 118 110 / 0.18), transparent 45%),
      linear-gradient(45deg, rgb(208 79 58 / 0.24), transparent 55%),
      var(--shade);
    display: flex;
    height: 100%;
    padding: 1.25rem;
    width: 100%;
  }

  .card-placeholder span {
    color: var(--ink-soft);
    font-weight: 750;
    max-width: 16rem;
  }

  .card-body {
    padding: 1.25rem;
  }

  .card-body > * + * {
    margin-top: 1rem;
  }

  .card-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: space-between;
  }

  .card-date {
    color: var(--accent-mid);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25rem;
  }

  .card-title {
    color: var(--ink-strong);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.75rem;
    margin-top: 0.25rem;
  }

  .card-badge {
    background: var(--badge-bg);
    border-radius: 999px;
    color: var(--badge-ink);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1rem;
    padding: 0.25rem 0.75rem;
  }

  .card-meta {
    color: var(--ink-subtle);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.78rem;
    font-weight: 650;
    gap: 0.4rem 0.6rem;
    line-height: 1.4;
  }

  .card-meta span {
    align-items: center;
    display: inline-flex;
  }

  .card-meta span + span::before {
    background: var(--line-strong);
    border-radius: 999px;
    content: "";
    display: inline-block;
    height: 0.3rem;
    margin-right: 0.6rem;
    width: 0.3rem;
  }

  .card-summary {
    color: var(--ink-muted);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover .card-media :global(img) {
      transform: none;
    }
  }
</style>
