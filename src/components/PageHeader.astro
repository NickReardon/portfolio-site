---
/* The opening band of every top-level page. One shell, one padding, and one
   text measure, so the heading holds still when navigating between pages.
   The title spans the shell so it wraps only when it has to; the copy under
   it is capped at --measure-text.
   Extra copy goes in the default slot; side buttons in the "actions" slot. */
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
}

const { eyebrow, title, lede } = Astro.props;
const hasActions = Astro.slots.has("actions");
---

<section class="section section-subtle">
  <div class="shell page-header">
    <div class="page-header-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      <slot />
    </div>
    {
      hasActions && (
        <div class="page-header-actions">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-header {
    display: grid;
    gap: 2rem;
  }

  /* Slotted copy is the caller's markup, so it needs :global to be reached. */
  .page-header-copy > :global(:not(h1)) {
    max-width: var(--measure-text);
  }

  .page-header-actions {
    display: grid;
    gap: 0.75rem;
    min-width: min(100%, 18rem);
  }

  @media (min-width: 64rem) {
    .page-header:has(.page-header-actions) {
      align-items: end;
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
