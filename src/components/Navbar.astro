---
import { Moon, Sun } from "@lucide/astro";
import { navigation, site } from "../site.config";

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="masthead">
  <nav class="masthead-inner">
    <a href="/" class="brand">
      <span class="brand-name">{site.name}</span>
      <span class="brand-role">{site.role}</span>
    </a>

    <div class="nav-links">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
            class:list={[
              "nav-link",
              isCurrent(item.href) && "nav-link-current",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <button type="button" class="theme-toggle" data-theme-toggle>
      {/* The icon names the theme the click moves to, matching the label. */}
      <Moon class="theme-icon theme-to-dark" aria-hidden="true" />
      <Sun class="theme-icon theme-to-light" aria-hidden="true" />
    </button>
  </nav>
</header>

<style>
  .masthead {
    border-bottom: 1px solid var(--line-soft);
    background: var(--surface-veil);
    backdrop-filter: blur(8px);
  }

  /* Brand and toggle share the top row, links take the one under it. The
     toggle is placed rather than left to flow: inside .nav-links it was a
     sixth item in an already-full wrap row, so it dropped to a line alone. */
  .masthead-inner {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr) auto;
    margin-inline: auto;
    max-width: var(--shell-max);
    padding: 1rem var(--shell-pad);
  }

  .nav-links {
    grid-column: 1 / -1;
  }

  .theme-toggle {
    align-self: center;
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
  }

  .brand {
    border-radius: 0.45rem;
    text-decoration: none;
    width: max-content;
  }

  .brand-name {
    display: block;
    color: var(--accent-mid);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1.25rem;
    text-transform: uppercase;
  }

  .brand-role {
    display: block;
    color: var(--ink-muted);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .nav-link {
    border: 1px solid transparent;
    border-radius: 0.45rem;
    color: var(--ink-body);
    display: inline-flex;
    font-size: 0.9rem;
    font-weight: 650;
    line-height: 1;
    padding: 0.62rem 0.72rem;
    text-decoration: none;
    transition:
      background 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .nav-link:hover {
    background: var(--surface-muted);
    border-color: var(--shade);
    color: var(--ink);
  }

  .nav-link-current,
  .nav-link-current:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--surface);
  }

  /* Hidden until the inline head script sets data-theme: without JavaScript
     the colours still follow the OS, but nothing can act on a click. */
  .theme-toggle {
    background: none;
    border: 1px solid transparent;
    border-radius: 0.45rem;
    color: var(--ink-body);
    cursor: pointer;
    display: none;
    padding: 0.5rem;
    transition:
      background 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  :root[data-theme] .theme-toggle {
    display: inline-flex;
  }

  .theme-toggle:hover {
    background: var(--surface-muted);
    border-color: var(--shade);
    color: var(--ink);
  }

  .theme-icon {
    height: 1.125rem;
    width: 1.125rem;
  }

  .theme-to-light {
    display: none;
  }

  :root[data-theme="dark"] .theme-to-dark {
    display: none;
  }

  :root[data-theme="dark"] .theme-to-light {
    display: block;
  }

  @media (min-width: 40rem) {
    .masthead-inner {
      align-items: center;
      grid-template-columns: minmax(0, 1fr) auto auto;
    }

    .nav-links {
      grid-column: 2;
    }

    .theme-toggle {
      grid-column: 3;
    }
  }

  @media (max-width: 40rem) {
    .nav-link {
      font-size: 0.86rem;
      padding-inline: 0.48rem;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );

  if (toggle) {
    const relabel = () => {
      toggle.setAttribute(
        "aria-label",
        root.dataset.theme === "dark"
          ? "Switch to light theme"
          : "Switch to dark theme",
      );
    };

    relabel();

    toggle.addEventListener("click", () => {
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        /* Private modes can refuse storage; the theme still flips for this page. */
      }
      relabel();
    });
  }
</script>
