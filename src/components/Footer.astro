---
import { build, site } from "../site.config";
---

<footer class="site-footer">
  <div class="footer-inner">
    <p>
      &copy; {new Date().getFullYear()}{" "}
      {site.name}. Built with Astro and Cloudflare Pages.
    </p>
    <p class="build-stamp">
      {!site.isSearchIndexable && `${build.branch} · `}
      {build.tree}
      {
        !site.isSearchIndexable && (
          <>
            {" · "}
            {build.commitUrl ? (
              <a href={build.commitUrl} class="text-link">
                {build.commit}
              </a>
            ) : (
              build.commit
            )}
            {" · updated "}
            {/* Rendered in UTC; the inline script below rewrites it to the
                viewer's own timezone. */}
            <time datetime={build.updated} data-localize>
              {new Intl.DateTimeFormat("en-US", {
                dateStyle: "medium",
                timeStyle: "short",
                timeZone: "UTC",
              }).format(new Date(build.updated))}{" "}
              UTC
            </time>
            {build.compareApiUrl && <span data-compare={build.compareApiUrl} />}
          </>
        )
      }
    </p>
    <div class="footer-links">
      <a href={`mailto:${site.email}`} class="text-link">Email</a>
      {
        site.githubUrl && (
          <a href={site.githubUrl} class="text-link">
            GitHub
          </a>
        )
      }
      <a href={site.itchUrl} class="text-link">Itch.io</a>
      <a href={site.linkedinUrl} class="text-link">LinkedIn</a>
      <a href={site.resumeUrl} class="text-link">Resume</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line-soft);
    background: var(--surface);
  }

  .footer-inner {
    color: var(--ink-subtle);
    display: flex;
    flex-direction: column;
    font-size: 0.875rem;
    gap: 1rem;
    line-height: 1.25rem;
    margin-inline: auto;
    max-width: var(--shell-max);
    padding: 2rem var(--shell-pad);
  }

  .build-stamp {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (min-width: 40rem) {
    .footer-inner {
      align-items: center;
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>

<script is:inline>
  for (const el of document.querySelectorAll("time[data-localize]")) {
    el.textContent = new Date(el.dateTime).toLocaleString(undefined, {
      dateStyle: "medium",
      timeStyle: "short",
    });
  }

  const compare = document.querySelector("[data-compare]");
  if (compare) {
    fetch(compare.dataset.compare)
      .then((response) => (response.ok ? response.json() : null))
      .then((result) => {
        // Only ahead_by. behind_by counts the staging -> main merge commits,
        // which live on main alone and are never merged back, so it grows
        // without bound while saying nothing about content.
        if (result?.ahead_by) {
          compare.textContent = ` · ${result.ahead_by} ahead of main`;
        }
      })
      // A rate-limited or offline compare just leaves the stamp as built.
      .catch(() => {});
  }
</script>
