---
import { build, site } from "../site.config";
---

<footer class="border-t border-stone-200 bg-white">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-8 text-sm text-stone-600 sm:flex-row sm:items-center sm:justify-between"
  >
    <p>
      &copy; {new Date().getFullYear()}
      {site.name}. Built with Astro and Cloudflare Pages.
    </p>
    <p class="font-mono text-xs text-stone-500">
      {!site.isSearchIndexable && `${build.branch} · `}
      {build.tree}
      {
        !site.isSearchIndexable && (
          <>
            {" · "}
            {build.commitUrl ? (
              <a href={build.commitUrl} class="footer-link">
                {build.commit}
              </a>
            ) : (
              build.commit
            )}
            {" · updated "}
            {/* Rendered in UTC; the inline script below rewrites it to the
                viewer's own timezone. */}
            <time datetime={build.updated} data-localize>
              {new Intl.DateTimeFormat("en-US", {
                dateStyle: "medium",
                timeStyle: "short",
                timeZone: "UTC",
              }).format(new Date(build.updated))}{" "}
              UTC
            </time>
            {build.compareApiUrl && <span data-compare={build.compareApiUrl} />}
          </>
        )
      }
    </p>
    <div class="flex flex-wrap gap-4">
      <a href={`mailto:${site.email}`} class="footer-link">Email</a>
      {
        site.githubUrl && (
          <a href={site.githubUrl} class="footer-link">
            GitHub
          </a>
        )
      }
      <a href={site.itchUrl} class="footer-link">Itch.io</a>
      <a href={site.linkedinUrl} class="footer-link">LinkedIn</a>
      <a href={site.resumeUrl} class="footer-link">Resume</a>
    </div>
  </div>
</footer>

<script is:inline>
  for (const el of document.querySelectorAll("time[data-localize]")) {
    el.textContent = new Date(el.dateTime).toLocaleString(undefined, {
      dateStyle: "medium",
      timeStyle: "short",
    });
  }

  const compare = document.querySelector("[data-compare]");
  if (compare) {
    fetch(compare.dataset.compare)
      .then((response) => (response.ok ? response.json() : null))
      .then((result) => {
        // Only ahead_by. behind_by counts the staging -> main merge commits,
        // which live on main alone and are never merged back, so it grows
        // without bound while saying nothing about content.
        if (result?.ahead_by) {
          compare.textContent = ` · ${result.ahead_by} ahead of main`;
        }
      })
      // A rate-limited or offline compare just leaves the stamp as built.
      .catch(() => {});
  }
</script>
