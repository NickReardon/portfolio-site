---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { Code, ExternalLink, Play } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { entrySlug, formatDate, isVisibleContent } from "../../utils/content";

interface Props {
  project: CollectionEntry<"projects">;
}

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter(isVisibleContent);

  return projects.map((project) => ({
    params: { slug: entrySlug(project.id) },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const links = [
  { href: project.data.githubUrl, label: "GitHub", Icon: Code },
  { href: project.data.videoUrl, label: "Video", Icon: Play },
  {
    href: project.data.externalUrl,
    label: project.data.externalLabel ?? "Live Site",
    Icon: ExternalLink,
  },
].filter((link) => Boolean(link.href));
const details = [
  { label: "Role", value: project.data.role },
  { label: "Status", value: project.data.status },
  { label: "Engine", value: project.data.engine },
].filter((detail) => Boolean(detail.value));
const timeline = project.data.timeline ?? formatDate(project.data.date);
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  image={project.data.coverImage}
  type="article"
>
  <article>
    <header class="section section-subtle">
      <div class="shell project-hero">
        <div>
          <p class="eyebrow">{timeline}</p>
          <h1>{project.data.title}</h1>
          <p class="lede">{project.data.description}</p>
          <div class="tag-row hero-tags">
            {project.data.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
          {
            details.length > 0 && (
              <dl class="detail-grid">
                {details.map((detail) => (
                  <div class="project-detail">
                    <dt>{detail.label}</dt>
                    <dd>{detail.value}</dd>
                  </div>
                ))}
              </dl>
            )
          }
          {
            links.length > 0 && (
              <div class="button-row hero-links">
                {links.map(({ href, label, Icon }) => (
                  <a class="button-secondary" href={href}>
                    <Icon size={16} aria-hidden="true" />
                    {label}
                  </a>
                ))}
              </div>
            )
          }
        </div>

        {
          project.data.coverImage && (
            <div class="hero-media">
              <Image
                src={project.data.coverImage}
                alt={project.data.coverAlt ?? ""}
                width={760}
                height={475}
                loading="eager"
                fetchpriority="high"
              />
            </div>
          )
        }
      </div>
    </header>

    <div class="section shell shell-sm">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .project-hero {
    display: grid;
    gap: 2.5rem;
  }

  .hero-tags {
    margin-top: 1.5rem;
  }

  .hero-links {
    margin-top: 2rem;
  }

  .detail-grid {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .project-detail {
    border-top: 3px solid var(--accent-bright);
    background: var(--surface);
    padding: 0.9rem 1rem;
  }

  .project-detail dt {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .project-detail dd {
    color: var(--ink-soft);
    font-size: 0.95rem;
    font-weight: 700;
    margin-top: 0.35rem;
  }

  /* <Image> renders its own <img>; .hero-media is scoped and keeps this local. */
  .hero-media :global(img) {
    aspect-ratio: 16 / 10;
    border: 1px solid var(--line-soft);
    border-radius: 0.5rem;
    box-shadow:
      0 1px 3px 0 rgb(0 0 0 / 0.1),
      0 1px 2px -1px rgb(0 0 0 / 0.1);
    object-fit: cover;
    width: 100%;
  }

  @media (min-width: 40rem) {
    .detail-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .project-hero {
      grid-template-columns: 1fr 380px;
    }
  }
</style>
