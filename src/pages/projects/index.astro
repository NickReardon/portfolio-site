---
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projectCategories } from "../../site.config";
import { isVisibleContent, sortProjects } from "../../utils/content";

const projects = (await getCollection("projects"))
  .filter(isVisibleContent)
  .sort(sortProjects);
const listed = new Set(projectCategories.map((category) => category.name));
/* Listed categories in configured order, then any category a project authored
   for itself, so an unconfigured group reads plainly instead of vanishing. */
const groups = [
  ...projectCategories,
  ...[...new Set(projects.map((project) => project.data.category))]
    .filter((name) => !listed.has(name))
    .sort()
    .map((name) => ({ name, eyebrow: "Projects", heading: name, link: null })),
]
  .map((group) => ({
    ...group,
    id: `projects-${group.name.toLowerCase().replace(/[^a-z0-9]+/gu, "-")}`,
    entries: projects.filter((project) => project.data.category === group.name),
  }))
  .filter((group) => group.entries.length > 0);
---

<BaseLayout
  title="Projects"
  description="Portfolio projects and technical case studies."
>
  <section class="section section-subtle">
    <div class="shell">
      <p class="eyebrow">Projects</p>
      <h1>Projects and case studies</h1>
      <p class="lede">
        Playable game-jam projects, Unreal Engine systems work, and notes on
        what I contributed to each project.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      {
        projects.length > 0 ? (
          <div class="project-groups">
            {groups.map((group, groupIndex) => (
              <section aria-labelledby={group.id}>
                <div class="section-heading">
                  <div>
                    <p class="eyebrow">{group.eyebrow}</p>
                    <h2 id={group.id}>{group.heading}</h2>
                  </div>
                  {group.link && (
                    <a class="text-link" href={group.link.href}>
                      {group.link.label}
                    </a>
                  )}
                </div>
                <div class="card-grid">
                  {group.entries.map((project, index) => (
                    <ProjectCard
                      project={project}
                      imageLoading={index < 3 ? "eager" : "lazy"}
                      imageFetchPriority={
                        /* Only the first card of the first rendered group is
                           above the fold, whichever group that turns out to
                           be. */
                        groupIndex === 0 && index === 0 ? "high" : "auto"
                      }
                    />
                  ))}
                </div>
              </section>
            ))}
          </div>
        ) : (
          <p class="empty-state">More project writeups are coming soon.</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .lede {
    max-width: 48rem;
  }

  .project-groups > * + * {
    margin-top: 3.5rem;
  }
</style>
