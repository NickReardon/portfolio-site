---
import { Download, ExternalLink, FileText, Mail } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import resume from "../data/resume.json";
import { site } from "../site.config";

const linkedInProfile = resume.basics.profiles.find(
  (profile) => profile.network === "LinkedIn",
);
const itchProfile = resume.basics.profiles.find(
  (profile) => profile.network === "Itch.io",
);
const githubProfile = resume.basics.profiles.find(
  (profile) => profile.network === "GitHub",
);

function formatEducation(school: (typeof resume.education)[number]) {
  const parts = [school.studyType, school.area].filter(Boolean);
  return parts.join(" in ");
}

function formatDate(date: string | undefined) {
  if (!date) {
    return undefined;
  }

  if (date.toLowerCase() === "present") {
    return "Present";
  }

  const [year, month] = date.split("-");
  if (!month) {
    return year;
  }

  return new Intl.DateTimeFormat("en", {
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(Date.UTC(Number(year), Number(month) - 1)));
}

function formatDateRange(
  startDate: string | undefined,
  endDate: string | undefined,
) {
  return [formatDate(startDate), formatDate(endDate)]
    .filter(Boolean)
    .join(" - ");
}

function projectMeta(project: (typeof resume.projects)[number]) {
  const dateText =
    project.dateLabel ?? formatDateRange(project.startDate, project.endDate);
  return [dateText, ...(project.keywords ?? [])].filter(Boolean).join(" | ");
}

function projectPageHref(project: (typeof resume.projects)[number]) {
  return project.siteUrl;
}

function playHref(project: (typeof resume.projects)[number]) {
  return project.availability === "Playable" ? project.url : undefined;
}

function workMeta(job: (typeof resume.work)[number]) {
  return [job.name, formatDateRange(job.startDate, job.endDate), job.location]
    .filter(Boolean)
    .join(" | ");
}
---

<BaseLayout title="Resume" description={`Resume for ${resume.basics.name}.`}>
  <section class="section section-divided-bottom section-subtle">
    <div class="shell shell-hero resume-hero">
      <div class="resume-intro">
        <p class="eyebrow">Resume</p>
        <h1>{resume.basics.name}</h1>
        <p class="lede">
          {resume.basics.label} focused on {site.focus}.
        </p>
      </div>

      <div class="resume-actions">
        <a class="button-primary" href={`mailto:${resume.basics.email}`}>
          <Mail size={16} aria-hidden="true" />
          Contact
        </a>
        <a
          class="button-secondary"
          href={site.resumePdfUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <ExternalLink size={16} aria-hidden="true" />
          Open PDF
        </a>
        <a
          class="button-secondary"
          href={site.resumePdfUrl}
          target="_blank"
          rel="noopener noreferrer"
          download
        >
          <Download size={16} aria-hidden="true" />
          Download PDF
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell resume-layout">
      <div class="resume-main">
        <section class="resume-panel">
          <h2 class="eyebrow">Profile</h2>
          <p class="resume-headline">
            Gameplay systems with practical authoring workflows.
          </p>
          <p>{resume.basics.summary}</p>
        </section>

        {
          resume.projects.length > 0 && (
            <section class="resume-panel">
              <h2 class="eyebrow">Project Experience</h2>
              {resume.projects.map((project) => (
                <div class="resume-entry">
                  <div>
                    <h3>{project.name}</h3>
                    <p class="resume-meta">{projectMeta(project)}</p>
                    {(projectPageHref(project) || playHref(project)) && (
                      <p class="entry-links">
                        {projectPageHref(project) && (
                          <a class="text-link" href={projectPageHref(project)}>
                            Project page
                          </a>
                        )}
                        {projectPageHref(project) && playHref(project) && (
                          <span class="entry-divider" aria-hidden="true">
                            |
                          </span>
                        )}
                        {playHref(project) && (
                          <a
                            class="text-link"
                            href={playHref(project)}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            Play on itch.io
                          </a>
                        )}
                      </p>
                    )}
                  </div>
                  {project.description && <p>{project.description}</p>}
                  {project.highlights?.length > 0 && (
                    <ul class="resume-highlights">
                      {project.highlights.map((highlight) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
            </section>
          )
        }

        {
          resume.work.length > 0 && (
            <section class="resume-panel">
              <h2 class="eyebrow">Experience</h2>
              {resume.work.map((job) => (
                <div class="resume-entry">
                  <div>
                    <h3>{job.position}</h3>
                    <p class="resume-meta">{workMeta(job)}</p>
                  </div>
                  {job.highlights?.length > 0 && (
                    <ul class="resume-highlights">
                      {job.highlights.map((highlight) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
            </section>
          )
        }
      </div>

      <aside class="resume-sidebar">
        {
          resume.education.length > 0 && (
            <section class="resume-sidebar-block">
              <h2>Education</h2>
              <div class="sidebar-entries">
                {resume.education.map((school) => (
                  <div class="resume-sidebar-entry">
                    <h3>{school.institution}</h3>
                    <p>{formatEducation(school)}</p>
                    {school.summary && <p>{school.summary}</p>}
                    {school.highlights?.map((highlight) => (
                      <p>{highlight}</p>
                    ))}
                  </div>
                ))}
              </div>
            </section>
          )
        }

        {
          resume.skills.length > 0 && (
            <section class="resume-sidebar-block">
              <h2>Technical Focus</h2>
              <div class="sidebar-entries">
                {resume.skills.map((skill) => (
                  <div class="resume-skill-group">
                    <h3>{skill.name}</h3>
                    <p>{skill.keywords.join(", ")}</p>
                  </div>
                ))}
              </div>
            </section>
          )
        }

        <section class="resume-sidebar-block">
          <h2>Links</h2>
          <div class="resume-link-grid">
            <a class="resume-link" href={`mailto:${resume.basics.email}`}>
              <Mail size={16} aria-hidden="true" />
              Email
            </a>
            {
              githubProfile && (
                <a
                  class="resume-link"
                  href={githubProfile.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <ExternalLink size={16} aria-hidden="true" />
                  GitHub
                </a>
              )
            }
            {
              linkedInProfile && (
                <a
                  class="resume-link"
                  href={linkedInProfile.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <ExternalLink size={16} aria-hidden="true" />
                  LinkedIn
                </a>
              )
            }
            {
              itchProfile && (
                <a
                  class="resume-link"
                  href={itchProfile.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <ExternalLink size={16} aria-hidden="true" />
                  Itch.io
                </a>
              )
            }
            <a
              class="resume-link"
              href={site.resumePdfUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <FileText size={16} aria-hidden="true" />
              PDF
            </a>
          </div>
        </section>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .resume-hero {
    display: grid;
    gap: 2rem;
  }

  .resume-intro {
    max-width: 48rem;
  }

  .resume-actions {
    display: grid;
    gap: 0.75rem;
    min-width: min(100%, 18rem);
  }

  .resume-layout {
    display: grid;
    gap: 2rem;
  }

  .resume-main > * + * {
    margin-top: 2rem;
  }

  .resume-entry {
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0.75rem;
    padding-top: 1.2rem;
  }

  .resume-entry + .resume-entry {
    margin-top: 1.4rem;
  }

  .resume-entry h3 {
    font-size: 1.2rem;
  }

  .resume-panel .resume-headline {
    color: var(--ink);
    font-size: 1.45rem;
    font-weight: 650;
    line-height: 1.2;
    margin-top: 0.5rem;
  }

  .entry-links {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    font-size: 0.875rem;
    gap: 0.25rem 0.5rem;
    line-height: 1.25rem;
    margin-top: 0.25rem;
  }

  .entry-divider {
    color: var(--ink-faint);
  }

  .resume-highlights {
    color: var(--ink-muted);
    line-height: 1.7;
    list-style: disc;
    padding-left: 1.2rem;
  }

  .resume-highlights li + li {
    margin-top: 0.35rem;
  }

  .resume-sidebar {
    align-self: start;
    display: grid;
    gap: 1rem;
  }

  .resume-sidebar-block {
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--surface);
    padding: 1.25rem;
  }

  .resume-sidebar h2 {
    font-size: 1.15rem;
  }

  .sidebar-entries {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  .resume-sidebar-entry p,
  .resume-skill-group p {
    color: var(--ink-muted);
    font-size: 0.92rem;
    line-height: 1.55;
    margin-top: 0.35rem;
  }

  .resume-link-grid {
    display: grid;
    gap: 0.65rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 1rem;
  }

  .resume-link {
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    color: var(--accent);
    display: inline-flex;
    font-weight: 700;
    gap: 0.5rem;
    min-height: 2.55rem;
    padding: 0.65rem;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .resume-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }

  @media (min-width: 64rem) {
    .resume-hero {
      align-items: end;
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .resume-layout {
      grid-template-columns: minmax(0, 1fr) 320px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .resume-link:hover {
      transform: none;
    }
  }
</style>
