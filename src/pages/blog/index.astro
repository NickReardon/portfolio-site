---
import { getCollection } from "astro:content";
import BlogCard from "../../components/BlogCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isVisibleContent, sortNewestFirst } from "../../utils/content";

const posts = (await getCollection("blog"))
  .filter(isVisibleContent)
  .sort(sortNewestFirst);
---

<BaseLayout title="Blog" description="Devlog posts and technical notes.">
  <section class="section section-subtle">
    <div class="shell">
      <p class="eyebrow">Blog</p>
      <h1>Devlog and notes</h1>
      <p class="lede">
        Short notes on systems design, implementation tradeoffs, and what I
        learn while building projects.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell shell-md">
      {
        posts.length > 0 ? (
          <div class="post-list">
            {posts.map((post) => (
              <BlogCard post={post} />
            ))}
          </div>
        ) : (
          <p class="empty-state">Devlog posts are coming soon.</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .lede {
    max-width: 48rem;
  }

  .post-list {
    display: grid;
    gap: 1rem;
  }
</style>
