---
import { getCollection } from "astro:content";
import { FileText } from "@lucide/astro";
import BlogCard from "../components/BlogCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site.config";
import {
  isVisibleContent,
  sortNewestFirst,
  sortProjects,
} from "../utils/content";

const projects = (await getCollection("projects"))
  .filter(isVisibleContent)
  .sort(sortProjects);
const featuredProjects = projects
  .filter((project) => project.data.featured)
  .slice(0, 3);
const fallbackProjects =
  featuredProjects.length > 0 ? featuredProjects : projects.slice(0, 3);
const recentPosts = (await getCollection("blog"))
  .filter(isVisibleContent)
  .sort(sortNewestFirst)
  .slice(0, 2);
---

<BaseLayout>
  <section class="section section-divided-bottom section-subtle">
    <div class="shell shell-hero hero">
      <div class="hero-copy">
        <p class="eyebrow">Portfolio</p>
        <h1 class="hero-title">
          {site.name}
        </h1>
        <p class="lede hero-lede">
          {site.role} focused on {site.focus}.
        </p>
        <p class="body-copy hero-body">
          I build modular gameplay systems in Unreal Engine, with a focus on
          where state lives, how systems communicate, and how designers author
          content without needing new systems code.
        </p>
        <div class="button-row hero-actions">
          <a class="button-primary" href="/projects/">View Projects</a>
          <a class="button-secondary" href={site.resumeUrl}>
            <FileText size={16} aria-hidden="true" />
            Resume
          </a>
          <a class="button-secondary" href="/contact/">Contact</a>
        </div>
      </div>

      <aside class="focus-list">
        <p class="eyebrow">Current Focus</p>
        <ul>
          <li>Lyra-based Unreal Engine gameplay architecture.</li>
          <li>Data-driven combat, encounters, travel, and persistence.</li>
          <li>Designer-friendly authoring workflows and technical writeups.</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Selected Work</p>
          <h2>Featured projects</h2>
        </div>
        <a class="text-link" href="/projects/">All projects</a>
      </div>

      {
        fallbackProjects.length > 0 ? (
          <div class="card-grid">
            {fallbackProjects.map((project, index) => (
              <ProjectCard
                project={project}
                headingLevel={3}
                imageLoading={index < 3 ? "eager" : "lazy"}
                imageFetchPriority={index === 0 ? "high" : "auto"}
              />
            ))}
          </div>
        ) : (
          <p class="empty-state spaced-lg">
            More project writeups are coming soon.
          </p>
        )
      }
    </div>
  </section>

  <section class="section section-divided-top section-surface">
    <div class="shell closing">
      <div>
        <p class="eyebrow">About</p>
        <h2>
          Gameplay systems built around how people actually author content.
        </h2>
        <p class="body-copy closing-copy">
          My strongest work comes from Tethered, a Lyra-based Unreal Engine
          action rogue-lite prototype, and from game jams where I build gameplay
          systems, traversal mechanics, and small authoring tools under real
          production pressure.
        </p>
        <a class="button-secondary closing-action" href="/about/"
          >Read more about me</a
        >
      </div>

      <div>
        <div class="section-heading">
          <div>
            <p class="eyebrow">Devlog</p>
            <h2>Latest posts</h2>
          </div>
          <a class="text-link" href="/blog/">All posts</a>
        </div>
        {
          recentPosts.length > 0 ? (
            <div class="post-list">
              {recentPosts.map((post) => (
                <BlogCard post={post} headingLevel={3} />
              ))}
            </div>
          ) : (
            <p class="empty-state spaced">Devlog posts are coming soon.</p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: 2rem;
  }

  .hero-copy {
    max-width: 48rem;
  }

  .hero-title {
    margin-top: 1rem;
  }

  .hero-lede {
    margin-top: 1rem;
  }

  .hero-body {
    margin-top: 1.25rem;
    max-width: 42rem;
  }

  .focus-list {
    border-left: 4px solid var(--accent-bright);
    padding-left: 1.5rem;
  }

  .focus-list ul {
    color: var(--ink-body);
    font-size: 0.875rem;
    line-height: 1.5rem;
    margin-top: 1rem;
  }

  .focus-list li + li {
    margin-top: 0.75rem;
  }

  .closing {
    display: grid;
    gap: 2.5rem;
  }

  .closing-copy {
    margin-top: 1rem;
  }

  .closing-action {
    display: inline-flex;
    margin-top: 1.5rem;
  }

  .post-list {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .spaced {
    margin-top: 1.5rem;
  }

  .spaced-lg {
    margin-top: 2rem;
  }

  /* Three actions do not fit on one line on a narrow phone; the primary takes
     the full first row and the two secondaries share the second. */
  @media (max-width: 30rem) {
    .hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .hero-actions .button-primary {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      align-items: end;
      grid-template-columns: minmax(0, 1fr) 340px;
    }

    .closing {
      gap: 2.5rem;
      grid-template-columns: 0.9fr 1.1fr;
    }
  }
</style>
