---
import { Download, ExternalLink } from "@lucide/astro";
import { existsSync, readdirSync, statSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";

interface ResumePdf {
  fileName: string;
  href: string;
  label: string;
  size: string;
}

const pdfDirectory = join(process.cwd(), "public", "resumes");

const pdfs: ResumePdf[] = existsSync(pdfDirectory)
  ? readdirSync(pdfDirectory, { withFileTypes: true })
      .filter((entry) => entry.isFile() && entry.name.endsWith(".pdf"))
      .map((entry) => {
        const path = join(pdfDirectory, entry.name);

        return {
          fileName: entry.name,
          href: `/resumes/${entry.name}`,
          label: formatResumePdfLabel(entry.name),
          size: formatFileSize(statSync(path).size),
        };
      })
      .sort(sortResumePdfs)
  : [];

function formatResumePdfLabel(fileName: string) {
  const name = fileName.replace(/\.pdf$/u, "");

  if (name === "resume") {
    return "Default one-page resume";
  }

  if (name === "resume-full") {
    return "Full-length resume";
  }

  return name
    .replace(/^resume-/u, "")
    .split("-")
    .map((part) =>
      part === "pdf"
        ? "PDF"
        : part.replace(/^\w/u, (letter) => letter.toUpperCase()),
    )
    .join(" ");
}

function sortResumePdfs(left: ResumePdf, right: ResumePdf) {
  const leftRank = getResumePdfRank(left.fileName);
  const rightRank = getResumePdfRank(right.fileName);

  return leftRank - rightRank || left.fileName.localeCompare(right.fileName);
}

function getResumePdfRank(fileName: string) {
  if (fileName === "resume.pdf") {
    return 0;
  }

  if (fileName === "resume-full.pdf") {
    return 1;
  }

  return 2;
}

function formatFileSize(bytes: number) {
  const kibibytes = bytes / 1024;

  return `${kibibytes.toFixed(kibibytes >= 100 ? 0 : 1)} KB`;
}
---

<BaseLayout
  title="Resume PDFs"
  description="Rendered resume PDF variants for Nicholas Reardon."
  noindex
>
  <section class="section section-divided-bottom section-subtle">
    <div class="shell shell-hero">
      <p class="eyebrow">Resume PDFs</p>
      <h1>Rendered Resume PDFs</h1>
      <p class="lede">Generated PDF variants for review and download.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      {
        pdfs.length > 0 ? (
          <div class="pdf-list">
            {pdfs.map((pdf) => (
              <article class="resume-panel">
                <div class="pdf-row">
                  <div>
                    <h2 class="pdf-title">{pdf.label}</h2>
                    <p class="resume-meta pdf-file">
                      {pdf.fileName} | {pdf.size}
                    </p>
                  </div>
                  <div class="pdf-actions">
                    <a
                      class="button-secondary"
                      href={pdf.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <ExternalLink size={16} aria-hidden="true" />
                      Open
                    </a>
                    <a class="button-primary" href={pdf.href} download>
                      <Download size={16} aria-hidden="true" />
                      Download
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <section class="resume-panel">
            <h2>No PDFs Found</h2>
            <p class="empty-note">
              Add PDFs to <code>public/resumes/</code> to list them here.
            </p>
          </section>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .lede {
    max-width: 48rem;
  }

  .pdf-list {
    display: grid;
    gap: 1rem;
  }

  .pdf-row {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pdf-title {
    color: var(--ink-strong);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.75rem;
  }

  .pdf-file {
    margin-top: 0.25rem;
  }

  .pdf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .empty-note {
    margin-top: 0.75rem;
  }

  @media (min-width: 40rem) {
    .pdf-row {
      align-items: center;
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
