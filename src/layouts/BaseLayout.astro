---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { build, site } from "../site.config";
import "../styles/global.css";
// After global.css: the body elements style themselves with its tokens.
import "../styles/elements.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: "website" | "article";
}

const {
  title,
  description = site.description,
  image = site.defaultImage,
  noindex = false,
  type = "website",
} = Astro.props;
const pageTitle = title
  ? `${title} | ${site.name}`
  : `${site.name} | ${site.role}`;
const canonicalUrl = new URL(Astro.url.pathname, site.url).toString();
const socialImageUrl = new URL(image, site.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="build"
      content={`${build.commit} ${build.branch} ${build.time}`}
    />
    {
      (noindex || !site.isSearchIndexable) && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{pageTitle}</title>
    {
      /* Before first paint, so a pinned theme never flashes the other one.
        Inline and un-deferred on purpose: a bundled script runs too late.
        Resolving the OS preference here as well is what lets the rest of the
        theming key off data-theme alone. */
    }
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {
          /* Private modes can refuse storage; fall back to the OS preference. */
        }
        document.documentElement.dataset.theme =
          stored === "light" || stored === "dark"
            ? stored
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Navbar />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    background: var(--accent);
    border-radius: 0.45rem;
    color: var(--surface);
    font-weight: 700;
    left: 1rem;
    padding: 0.7rem 1rem;
    position: fixed;
    text-decoration: none;
    top: 1rem;
    transform: translateY(-150%);
    transition: transform 160ms ease;
    z-index: 50;
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
