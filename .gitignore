# all controlled local output, decrypted previews, indexes, drafts, and builds
.local/

# framework output that cannot be redirected
dist/
.astro/

# dependencies
node_modules/
.venv/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dev-server*.log

# generated audit reports
reports/
.audit-tmp/

# local worktrees and agent scratch space
.workspace/

# generated resume build files
.resume-build/

# private-source and draft artifacts must never be tracked
*.decrypted.*
*.private.pdf
*.resume-draft.json

# environment variables
.env
.env.*
!.env.example
!.env.*.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
