# Where `npm run deploy:*` gets Cloudflare credentials. Copy to .env and set
# whichever applies to this machine. Both files are gitignored.
#
#   op:<file>    run Wrangler under `op run --env-file <file>`, so secrets only
#                exist inside the subprocess. Use on a workstation.
#   env          CLOUDFLARE_API_TOKEN is already in the environment. Use in CI.
#   file:<file>  load KEY=VALUE pairs from <file>. Use where 1Password is not
#                available; keep that file out of the repository.
#
# Unset means: use the environment if it already carries a token, otherwise
# 1Password via ./.env.1password.
#
# Never put a token in this file. It is committed.
DEPLOY_CREDENTIALS=op:./.env.1password
